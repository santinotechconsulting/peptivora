# GEMINI_API_KEY: Required if optional AI features are enabled server-side.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / NEXT_PUBLIC_SITE_URL: Canonical HTTPS URL where PEPTIVORA is hosted.
APP_URL="https://peptivora.de"
NEXT_PUBLIC_SITE_URL="https://peptivora.de"

# Cloud SQL PostgreSQL connection variables (active runtime database)
SQL_HOST="MY_SQL_HOST"
SQL_DB_NAME="MY_SQL_DB_NAME"
SQL_USER="MY_SQL_USER"
SQL_PASSWORD="MY_SQL_PASSWORD"
SQL_ADMIN_USER="MY_SQL_ADMIN_USER"
SQL_ADMIN_PASSWORD="MY_SQL_ADMIN_PASSWORD"

# Optional bootstrap email for initial compliance super_administrator assignment
ADMIN_BOOTSTRAP_EMAIL=""

# Portable Supabase / PostgreSQL reference environment variables (if deployed to Supabase + Vercel)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Payment & Settlement Providers (server-side only; never expose secrets client-side)
PAYMENT_PROVIDER_API_KEY="YOUR_PAYMENT_PROVIDER_API_KEY"
PAYMENT_WEBHOOK_SECRET="YOUR_PAYMENT_WEBHOOK_SECRET"

# Transactional Email Service (server-side only)
EMAIL_SERVICE_API_KEY="YOUR_EMAIL_SERVICE_API_KEY"
EMAIL_FROM_ADDRESS="compliance@peptivora.example"

# Google Analytics / Tag Manager (only activated client-side after explicit consent)
GA4_MEASUREMENT_ID=""
GTM_CONTAINER_ID=""

# Application Error & Telemetry Monitoring (server/edge DSN)
MONITORING_DSN=""
